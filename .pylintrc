
[MASTER]
# Specify a configuration file.
rcfile=

# Python code to execute, usually to sys.path.append paths.
init-hook=

# Add files or directories to the blacklist. They should be base names, not paths.
ignore=CVS

# Add files or directories matching the regex patterns to the blacklist. The regex matches against base names, not paths.
ignore-patterns=

# Pickle collected data for later comparisons.
persistent=yes

# List of plugins (as comma separated values of python module names) to load, usually to register additional checkers.
load-plugins=

[MESSAGES CONTROL]
# Only show warnings with the listed confidence levels. Leave empty to show all. Valid levels: HIGH, INFERENCE, INFERENCE_FAILURE, UNDEFINED
confidence=

# Disable the message, report, category or checker with the given id(s). You can either give multiple identifiers separated by comma (,) or put this option multiple times (only on the command line, not in the configuration file where it should appear only once).
# fixme: this repo deliberately carries TODO markers for complexity findings
#   that are accepted for now (see max-complexity disables below) and revisited
#   once proprietary-mode support lands; they are intentionally long-lived, not
#   "must fix before merge" markers, so failing the build on them is not useful.
# too-few-public-methods: several classes here (Patch, IgnoreConfig) are
#   deliberately single-purpose data holders; forcing a second method would be
#   busywork, not better design.
# duplicate-code: cannot be scoped with an inline `# pylint: disable=` comment
#   in this pylint version (verified -- R0801 is a whole-run similarity
#   checker, not a per-node one). Two spans are accepted as genuine but not
#   worth abstracting:
#     - main.py's detect_license_from_file() / scanner/license_scancode.py's
#       detect_licenses_batch(): the scancode subprocess.run() invocation.
#     - tests/test_copyright_checker.py's make_change() /
#       tests/test_license_scancode.py's make_change(): a small fixture dict
#       literal, one test-only helper apiece.
#   Other duplication pylint has flagged here (the scancode-mock JSON builder
#   and the tempdir/chdir test setUp) was extracted into
#   tests/scancode_mock.py rather than accepted -- re-run without this
#   disable and check tests/scancode_mock.py's callers if a new span appears.
disable=missing-docstring,invalid-name,too-few-public-methods,duplicate-code,fixme

[REPORTS]
# Set the output format. Available formats are text, parseable, colorized, json and jsonlines
output-format=text

# Tells whether to display a full report or only the messages
reports=no

[LOGGING]
# Logging modules to check that the string format arguments are in logging function parameter format
logging-modules=logging

[BASIC]
# Good variable names which should always be accepted, separated by comma
good-names=i,j,k,ex,Run,_

# Bad variable names which should always be refused, separated by comma
bad-names=foo,bar,baz,toto,tutu,tata

[FORMAT]
# Maximum number of characters on a single line.
max-line-length=100

# Regexp for a line that is allowed to be longer than the limit.
ignore-long-lines=

[DESIGN]
# Maximum number of arguments for function / method
max-args=5

# Maximum number of attributes for a class (see R0902).
max-attributes=7

# Maximum number of public methods for a class (see R0904).
max-public-methods=20

[IMPORTS]
# List of modules that can have C extensions (builtins are automatically added).
extension-pkg-whitelist=

[CLASSES]
# List of method names used to declare (i.e. assign) instance attributes.
defining-attr-methods=__init__,__new__,setUp

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught. Defaults to "Exception"
overgeneral-exceptions=builtins.Exception
